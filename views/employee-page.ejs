
<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Employee Management</title>

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/styles/employee-page.css"
  >

  <link
    rel="stylesheet"
    href="/styles/admin-navigation.css"
  >
</head>


<body>

  <!-- ========================
       TOPBAR
  ========================= -->

  <header class="topbar">

    <!-- LEFT -->

    <div class="topbar-left">

      <div class="brand-mark">
        EM
      </div>

      <div>

        <p class="topbar-eyebrow">
          Employee Management
        </p>

        <h2 class="topbar-title">
          Employees
        </h2>

      </div>

    </div>


    <!-- ========================
         ADMIN NAVIGATION
    ========================= -->

    <% if (
      currentUser.role === "admin"
    ) { %>

      <nav class="admin-nav">

        <a
          href="/admin/dashboard"
          class="admin-nav-link"
        >
          Dashboard
        </a>

        <a
          href="/employees"
          class="admin-nav-link active"
        >
          Employees
        </a>

        <a
          href="/admin/users"
          class="admin-nav-link"
        >
          User Management
        </a>

        <a
          href="/audit-logs"
          class="admin-nav-link"
        >
          Audit Logs
        </a>

      </nav>

    <% } %>


    <!-- ========================
         RIGHT
    ========================= -->

    <div class="topbar-right">

      <div class="user-card">

        <div class="avatar">
          <%= currentUser.username
            .charAt(0)
            .toUpperCase()
          %>
        </div>

        <div class="user-meta">

          <strong>
            <%= currentUser.username %>
          </strong>

          <span class="role-badge">
            <%= currentUser.role %>
          </span>

        </div>

      </div>


      <form
        action="/logout"
        method="POST"
      >

        <button
          class="logout-btn"
          type="submit"
        >
          Logout
        </button>

      </form>

    </div>

  </header>


  <!-- ========================
       MAIN
  ========================= -->

  <main class="container">

    <!-- ========================
         EMPLOYEE LIST
    ========================= -->

    <section class="employee-container">

      <div class="section-heading">

        <div>

          <p class="section-eyebrow">
            Team overview
          </p>

          <h1 class="title">
            Employee List
          </h1>

        </div>


        <span class="employee-count">
          <%= totalEmployees %> employees
        </span>

      </div>


      <!-- ========================
           FILTER
      ========================= -->

      <form
        action="/employees"
        method="GET"
        class="filter-form"
      >

        <div class="filter-group">

          <input
            type="text"
            name="firstName"
            placeholder="First name"
            value="<%= filters.firstName || '' %>"
          >

          <input
            type="text"
            name="lastName"
            placeholder="Last name"
            value="<%= filters.lastName || '' %>"
          >

          <input
            type="text"
            name="jobTitle"
            placeholder="Job title"
            value="<%= filters.jobTitle || '' %>"
          >

          <button
            type="submit"
            class="filter-btn"
          >
            Filter
          </button>

          <a
            href="/employees"
            class="clear-btn"
          >
            Clear
          </a>

        </div>

      </form>


      <!-- ========================
           TABLE
      ========================= -->

      <div class="table-wrapper">

        <table>

          <thead>

            <tr>
              <th>No.</th>
              <th>First Name</th>
              <th>Last Name</th>
              <th>Extension</th>
              <th>Email</th>
              <th>Office</th>
              <th>Reports To</th>
              <th>Job Title</th>
            </tr>

          </thead>


          <tbody>

            <% if (
              employees &&
              employees.length > 0
            ) { %>

              <% employees.forEach(
                (employee) => {
              %>

                <tr
                  data-employee='<%= JSON.stringify(employee) %>'

                  <% if (
                    currentUser.role === "manager" ||
                    currentUser.role === "admin"
                  ) { %>

                    title="Click to edit employee"

                  <% } %>
                >

                  <td>

                    <span class="employee-number">
                      #<%= employee.employeeNumber %>
                    </span>

                  </td>

                  <td>
                    <strong>
                      <%= employee.firstName %>
                    </strong>
                  </td>

                  <td>
                    <%= employee.lastName %>
                  </td>

                  <td>
                    <%= employee.extension %>
                  </td>

                  <td class="employee-email">
                    <%= employee.email %>
                  </td>

                  <td>

                    <span class="office-badge">
                      <%= employee.officeCode %>
                    </span>

                  </td>

                  <td>
                    <%= employee.reportsTo || "-" %>
                  </td>

                  <td>
                    <%= employee.jobTitle %>
                  </td>

                </tr>

              <% }); %>

            <% } else { %>

              <tr>

                <td
                  colspan="8"
                  class="no-data"
                >

                  <div class="empty-state">

                    <div class="empty-icon">
                      ?
                    </div>

                    <strong>
                      No employees found
                    </strong>

                    <span>
                      Try changing your filters.
                    </span>

                  </div>

                </td>

              </tr>

            <% } %>

          </tbody>

        </table>

      </div>


      <!-- ========================
           PAGINATION
      ========================= -->

      <% if (totalPages > 1) { %>

        <div class="pagination">

          <% for (
            let i = 1;
            i <= totalPages;
            i++
          ) { %>

            <a
              href="/employees?page=<%= i %>&firstName=<%= encodeURIComponent(filters.firstName || '') %>&lastName=<%= encodeURIComponent(filters.lastName || '') %>&jobTitle=<%= encodeURIComponent(filters.jobTitle || '') %>"
              class="<%= currentpage === i ? 'active' : '' %>"
            >
              <%= i %>
            </a>

          <% } %>

        </div>

      <% } %>

    </section>


    <!-- ========================
         ADD EMPLOYEE
    ========================= -->

    <% if (
      currentUser.role === "manager" ||
      currentUser.role === "admin"
    ) { %>

      <aside class="add-container">

        <div class="add-header">

          <div class="add-icon">
            +
          </div>

          <div>

            <p class="section-eyebrow">
              Team member
            </p>

            <h2>
              Add Employee
            </h2>

          </div>

        </div>


        <form
          action="/employees/add"
          method="POST"
          class="add-form"
        >

          <div class="form-group">

            <label for="employeeNumber">
              Employee Number
            </label>

            <input
              type="number"
              id="employeeNumber"
              name="employeeNumber"
              placeholder="e.g. 1705"
              required
            >

          </div>


          <div class="form-group">

            <label for="firstName">
              First Name
            </label>

            <input
              type="text"
              id="firstName"
              name="firstName"
              placeholder="First name"
              required
            >

          </div>


          <div class="form-group">

            <label for="lastName">
              Last Name
            </label>

            <input
              type="text"
              id="lastName"
              name="lastName"
              placeholder="Last name"
              required
            >

          </div>


          <div class="form-group">

            <label for="extension">
              Extension
            </label>

            <input
              type="text"
              id="extension"
              name="extension"
              placeholder="e.g. x101"
              required
            >

          </div>


          <div class="form-group">

            <label for="email">
              Email
            </label>

            <input
              type="email"
              id="email"
              name="email"
              placeholder="employee@example.com"
              required
            >

          </div>


          <div class="form-group">

            <label for="officeCode">
              Office Code
            </label>

            <input
              type="text"
              id="officeCode"
              name="officeCode"
              placeholder="Office code"
              required
            >

          </div>


          <div class="form-group">

            <label for="reportsTo">
              Reports To
            </label>

            <input
              type="number"
              id="reportsTo"
              name="reportsTo"
              placeholder="Manager ID"
            >

          </div>


          <div class="form-group">

            <label for="jobTitle">
              Job Title
            </label>

            <input
              type="text"
              id="jobTitle"
              name="jobTitle"
              placeholder="Job title"
              required
            >

          </div>


          <button
            type="submit"
            class="submit-btn"
          >
            <span>+</span>
            Add Employee
          </button>

        </form>

      </aside>

    <% } %>


    <!-- ========================
         EDIT MODAL
    ========================= -->

    <% if (
      currentUser.role === "manager" ||
      currentUser.role === "admin"
    ) { %>

      <div class="edit-modal">

        <div class="modal-container">

          <div class="modal-header">

            <div>

              <p class="section-eyebrow">
                Employee profile
              </p>

              <h2>
                Employee Details
              </h2>

            </div>

            <button
              type="button"
              class="close-btn"
              aria-label="Close"
            >
              &times;
            </button>

          </div>


          <form
            action="/employees/update"
            method="POST"
            class="edit-form"
          >

            <div class="modal-body">

              <div class="form-group">

                <label for="edit-employeeNumber">
                  Employee Number
                </label>

                <input
                  type="number"
                  id="edit-employeeNumber"
                  name="employeeNumber"
                  readonly
                >

              </div>


              <div class="form-group">

                <label for="edit-firstName">
                  First Name
                </label>

                <input
                  type="text"
                  id="edit-firstName"
                  name="firstName"
                  required
                >

              </div>


              <div class="form-group">

                <label for="edit-lastName">
                  Last Name
                </label>

                <input
                  type="text"
                  id="edit-lastName"
                  name="lastName"
                  required
                >

              </div>


              <div class="form-group">

                <label for="edit-extension">
                  Extension
                </label>

                <input
                  type="text"
                  id="edit-extension"
                  name="extension"
                  required
                >

              </div>


              <div class="form-group">

                <label for="edit-email">
                  Email
                </label>

                <input
                  type="email"
                  id="edit-email"
                  name="email"
                  required
                >

              </div>


              <div class="form-group">

                <label for="edit-officeCode">
                  Office Code
                </label>

                <input
                  type="text"
                  id="edit-officeCode"
                  name="officeCode"
                  required
                >

              </div>


              <div class="form-group">

                <label for="edit-reportsTo">
                  Reports To
                </label>

                <input
                  type="number"
                  id="edit-reportsTo"
                  name="reportsTo"
                >

              </div>


              <div class="form-group">

                <label for="edit-jobTitle">
                  Job Title
                </label>

                <input
                  type="text"
                  id="edit-jobTitle"
                  name="jobTitle"
                  required
                >

              </div>

            </div>


            <div class="button-group">

              <% if (
                currentUser.role === "admin"
              ) { %>

                <button
                  type="button"
                  class="delete-button"
                >
                  Delete
                </button>

              <% } %>

              <button
                type="submit"
                class="save-button"
              >
                Save Changes
              </button>

            </div>

          </form>

        </div>

      </div>

    <% } %>


    <!-- ========================
         DELETE CONFIRM
    ========================= -->

    <% if (
      currentUser.role === "admin"
    ) { %>

      <div
        class="delete-confirm-modal"
        id="delete-confirm-modal"
      >

        <div class="delete-confirm-card">

          <div class="delete-warning-icon">
            !
          </div>

          <h2>
            Delete Employee?
          </h2>

          <p>
            You are about to delete

            <strong id="delete-employee-label">
              this employee
            </strong>.
          </p>

          <span class="delete-warning-text">
            This action cannot be undone.
          </span>


          <div class="delete-confirm-actions">

            <button
              type="button"
              class="cancel-delete-btn"
              id="cancel-delete-btn"
            >
              Cancel
            </button>

            <button
              type="button"
              class="confirm-delete-btn"
              id="confirm-delete-btn"
            >
              Delete Employee
            </button>

          </div>

        </div>

      </div>

    <% } %>

  </main>


  <!-- ========================
       SCRIPT
  ========================= -->

  <% if (
    currentUser.role === "manager" ||
    currentUser.role === "admin"
  ) { %>

    <script src="/scripts/employee-page.js"></script>

  <% } %>

</body>

</html>
