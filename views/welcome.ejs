<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Welcome | Employee Management</title>

  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
  >

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  >

  <link
    rel="stylesheet"
    href="/styles/welcome.css"
  >
</head>


<body>

  <div class="background-orb orb-one"></div>
  <div class="background-orb orb-two"></div>


  <header class="navbar">

    <a
      href="/"
      class="brand"
    >

      <div class="brand-mark">
        EM
      </div>

      <div class="brand-text">

        <strong>
          Employee Management
        </strong>

        <span>
          Full-stack web application
        </span>

      </div>

    </a>


    <nav class="nav-actions">

      <% if (currentUser) { %>

        <a
          href="/employees"
          class="login-link"
        >
          Dashboard
        </a>

        <form
          action="/logout"
          method="POST"
        >
          <button
            type="submit"
            class="register-link"
          >
            Logout
          </button>
        </form>

      <% } else { %>

        <a
          href="/login"
          class="login-link"
        >
          Login
        </a>

        <a
          href="/register"
          class="register-link"
        >
          Register
        </a>

      <% } %>

    </nav>

  </header>


  <main>

    <!-- ========================
         HERO
    ========================= -->

    <section class="hero">

      <div class="hero-content">

        <span class="hero-badge">
          Full-stack portfolio project
        </span>

        <h1>
          Manage your team
          <span>
            simply and securely.
          </span>
        </h1>

        <p class="hero-description">
          A modern employee management application
          with authentication, role-based access control,
          MySQL integration, Docker support, and cloud deployment.
        </p>


        <div class="hero-actions">

          <% if (currentUser) { %>

            <a
              href="/employees"
              class="primary-btn"
            >
              Open Dashboard
            </a>

          <% } else { %>

            <a
              href="/login"
              class="primary-btn"
            >
              Get Started
            </a>

            <a
              href="/register"
              class="secondary-btn"
            >
              Create Account
            </a>

          <% } %>

        </div>


        <div class="tech-row">

          <span>Node.js</span>
          <span>Express</span>
          <span>MySQL</span>
          <span>Docker</span>
          <span>Render</span>

        </div>

      </div>


      <div class="hero-preview">

        <div class="preview-card">

          <div class="preview-header">

            <div>

              <span class="preview-label">
                Dashboard Preview
              </span>

              <h3>
                Employee Management
              </h3>

            </div>

            <div class="preview-avatar">
              EM
            </div>

          </div>


          <div class="preview-stats">

            <div class="stat-card">

              <span class="stat-label">
                Employees
              </span>

              <strong>
                23
              </strong>

            </div>


            <div class="stat-card">

              <span class="stat-label">
                Roles
              </span>

              <strong>
                3
              </strong>

            </div>


            <div class="stat-card">

              <span class="stat-label">
                Database
              </span>

              <strong>
                MySQL
              </strong>

            </div>

          </div>


          <div class="preview-table">

            <div class="preview-row preview-row-header">

              <span>Employee</span>
              <span>Role</span>
              <span>Status</span>

            </div>


            <div class="preview-row">

              <span>
                Alex Morgan
              </span>

              <span>
                Manager
              </span>

              <span class="active-status">
                Active
              </span>

            </div>


            <div class="preview-row">

              <span>
                Sarah Wilson
              </span>

              <span>
                Employee
              </span>

              <span class="active-status">
                Active
              </span>

            </div>


            <div class="preview-row">

              <span>
                Daniel Lee
              </span>

              <span>
                Admin
              </span>

              <span class="active-status">
                Active
              </span>

            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- ========================
         ABOUT
    ========================= -->

    <section class="about-section">

      <div class="section-heading">

        <span>
          About the project
        </span>

        <h2>
          Built as a practical full-stack application
        </h2>

        <p>
          This project was created to practice web development,
          database design, authentication, authorization,
          containerization, and cloud deployment.
        </p>

      </div>


      <div class="feature-grid">

        <article class="feature-card">

          <div class="feature-icon">
            🔐
          </div>

          <h3>
            Authentication
          </h3>

          <p>
            Secure registration and login with
            bcrypt password hashing and sessions.
          </p>

        </article>


        <article class="feature-card">

          <div class="feature-icon">
            🛡️
          </div>

          <h3>
            Role-Based Access
          </h3>

          <p>
            Employee, Manager, and Admin roles
            with backend authorization controls.
          </p>

        </article>


        <article class="feature-card">

          <div class="feature-icon">
            📋
          </div>

          <h3>
            Employee CRUD
          </h3>

          <p>
            Search, filter, add, update,
            and delete employee information.
          </p>

        </article>


        <article class="feature-card">

          <div class="feature-icon">
            🐳
          </div>

          <h3>
            Docker
          </h3>

          <p>
            The application can be packaged
            and run consistently inside containers.
          </p>

        </article>

      </div>

    </section>


    <!-- ========================
         ABOUT ME
    ========================= -->

    <section class="about-me">

      <div class="about-card">

        <div class="about-avatar">
          NHV
        </div>


        <div class="about-content">

          <span class="about-label">
            About the developer
          </span>

          <h2>
            Nguyen Hoang Viet
          </h2>

          <p>
            I am a Network Security student interested in
            cybersecurity, web development, networking,
            and building practical security-focused projects.
          </p>


          <div class="interest-list">

            <span>
              Cybersecurity
            </span>

            <span>
              Web Development
            </span>

            <span>
              Networking
            </span>

            <span>
              Docker
            </span>

          </div>


          <a
            href="https://github.com/hoangviet47206"
            target="_blank"
            rel="noopener noreferrer"
            class="github-link"
          >
            View GitHub
          </a>

        </div>

      </div>

    </section>

  </main>


  <footer>

    <span>
      Employee Management System
    </span>

    <span>
      Built by Nguyen Hoang Viet
    </span>

  </footer>

</body>

</html>